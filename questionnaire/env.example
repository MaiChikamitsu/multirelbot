# この見本をquestionnaire/.envへコピーし、実際の値に変更する。
# .envは自動ロードしない。管理者だけが読めるファイルにして起動環境へ渡す。
QUESTIONNAIRE_PUBLIC=1
QUESTIONNAIRE_BASE_URL=https://questionnaire.example.org
QUESTIONNAIRE_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# 公開サーバー上の絶対パス。videos/とDBを同じ非公開領域に置く。
QUESTIONNAIRE_DATA_DIR=/srv/multirelbot/questionnaire/private
